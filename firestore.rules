rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    match /necesidades/{necesidadId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.colegioId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.colegioId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.colegioId == request.auth.uid;
    }

    match /donaciones/{donacionId} {
      allow create: if request.auth != null
                    && request.resource.data.empresaId == request.auth.uid;
      allow read: if request.auth != null
                  && (resource.data.empresaId == request.auth.uid
                      || resource.data.colegioId == request.auth.uid);
    }
  }
}
